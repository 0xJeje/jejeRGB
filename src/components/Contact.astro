---
// Contact details are base64-obfuscated to deter naive scrapers; decoded client-side.
---
<section id="contact" class="bg-accent text-black">
  <div class="container">
    <div class="contact-form-grid">
      <div>
        <h2 class="section-title text-black" style="margin-bottom: 2rem;">
          <span class="title-num" style="color: var(--black);">[05]</span> CONTACT
        </h2>

        <div class="contact-links" style="display: flex; flex-direction: column; gap: 1rem;">
          <a href="#" class="contact-btn secure-link" data-protocol="mailto:" data-sec="bmljYWRyYWdvajUzN0BnbWFpbC5jb20=">
            <span class="mono label">/// EMAIL</span>
            <span class="value secure-text" data-sec="bmljYWRyYWdvajUzN0BnbWFpbC5jb20=">REVEALING...</span>
          </a>

          <a href="#" class="contact-btn secure-link" data-protocol="tel:" data-sec="KzQwNzI5NTkyNzY3">
            <span class="mono label">
              <span class="ro">/// TELEFON</span><span class="en">/// PHONE</span>
            </span>
            <span class="value secure-text" data-sec="KzQwNzI5NTkyNzY3">REVEALING...</span>
          </a>

          <a href="#" class="contact-btn secure-link" data-protocol="https://wa.me/" data-sec="NDA3Mjk1OTI3Njc=">
            <span class="mono label">/// WHATSAPP </span>
            <span class="value">
              <span class="ro">Deschide chat ↗</span><span class="en">Open chat ↗</span>
            </span>
          </a>
        </div>

        <div id="terminal-checks" style="margin-top: 3rem; font-family: var(--font-mono); font-size: 0.75rem; color: rgba(0,0,0,0.6); display: flex; flex-direction: column; gap: 0.6rem;">
          <div class="check-item" style="opacity: 0; transform: translateX(-10px);">
            <span class="text-black" style="font-weight: 700;">&gt;</span>
            <span class="ro">Are studii superioare în domeniu</span>
            <span class="en">Has academic studies in the field</span>
          </div>
          <div class="check-item" style="opacity: 0; transform: translateX(-10px);">
            <span class="text-black" style="font-weight: 700;">&gt;</span>
            <span class="ro">Poate emite factură fiscală</span>
            <span class="en">Can issue a legal invoice</span>
          </div>
          <div class="check-item" style="opacity: 0; transform: translateX(-10px);">
            <span class="text-black" style="font-weight: 700;">&gt;</span>
            <span class="ro">Lucrează pe bază de brief, nu pe bază de 'chef' </span>
            <span class="en">Works on a brief basis, not on a 'mood' basis</span>
          </div>
        </div>
      </div>

      <div class="footer-merged" style="display: flex; flex-direction: column; justify-content: flex-end; padding-top: 2rem;">
        <div style="border-top: 2px solid rgba(0,0,0,0.1); padding-top: 2rem; margin-top: auto;">
          <p class="mono" style="font-weight: 700; margin-bottom: 0.5rem; font-size: 1.2rem;">NICA DRAGOȘ // PORTFOLIO</p>
          <p class="mono" style="font-size: 0.9rem; opacity: 0.8;">
            <span class="ro">© 2026 TOATE DREPTURILE REZERVATE</span>
            <span class="en">© 2026 ALL RIGHTS RESERVED</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
