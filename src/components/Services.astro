---
const services = [
  {
    num: '01',
    href: '#branding',
    title_ro: 'Branding & Identitate',
    title_en: 'Branding & Identity',
    desc_ro:
      'Logo, identitate vizuală și sisteme de brand cu impact. Agenție de branding pentru afaceri din Valea Jiului și toată România.',
    desc_en:
      'Logos, visual identity and high-impact brand systems. Branding studio for businesses in Valea Jiului and across Romania.',
  },
  {
    num: '02',
    href: '#graphic-design',
    title_ro: 'Design Grafic & Reclame',
    title_en: 'Graphic Design & Ads',
    desc_ro:
      'Designer grafic pentru postere, coperți, materiale promoționale și reclame care opresc scroll-ul.',
    desc_en:
      'Graphic designer for posters, covers, promotional materials and scroll-stopping ads.',
  },
  {
    num: '03',
    href: '#video-social',
    title_ro: 'Editare Video & Social',
    title_en: 'Video Editing & Social',
    desc_ro:
      'Video editor și strateg social media: conținut short-form și long-form optimizat pentru retenție și milioane de vizualizări.',
    desc_en:
      'Video editor and social media strategist: short-form and long-form content built for retention and millions of views.',
  },
  {
    num: '04',
    href: '#web-dev',
    title_ro: 'Web Development',
    title_en: 'Web Development',
    desc_ro:
      'Website-uri rapide, optimizate SEO și pentru mobil. Digital marketing și prezență online completă.',
    desc_en:
      'Fast, SEO- and mobile-optimized websites. Digital marketing and a complete online presence.',
  },
];
---
<section id="servicii" class="bg-black">
  <div class="container">
    <div class="design-grid-top">
      <h2 class="section-title"><span class="title-num">[00]</span> <span class="ro">SERVICII</span><span class="en">SERVICES</span></h2>
      <p class="desc-text">
        <span class="ro">Agenție multimedia & de producție publicitară. Un singur partener pentru branding, web, video și marketing.</span>
        <span class="en">A multimedia & advertising production studio. One partner for branding, web, video and marketing.</span>
      </p>
    </div>

    <div class="services-grid">
      {
        services.map((s) => (
          <a class="service-card" href={s.href}>
            <span class="svc-num">{s.num}</span>
            <h3 class="ro">{s.title_ro}</h3>
            <h3 class="en">{s.title_en}</h3>
            <p class="ro">{s.desc_ro}</p>
            <p class="en">{s.desc_en}</p>
            <span class="svc-arrow">→</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
