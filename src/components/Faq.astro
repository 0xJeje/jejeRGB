---
import { FAQ } from '../data/site.js';
---
<section id="faq" class="bg-black">
  <div class="container">
    <div class="design-grid-top">
      <h2 class="section-title"><span class="title-num">[?]</span> FAQ</h2>
      <p class="desc-text">
        <span class="ro" lang="ro">Întrebări frecvente despre serviciile de marketing, branding, web și video.</span>
        <span class="en" lang="en" data-nosnippet hidden>Frequently asked questions about marketing, branding, web and video services.</span>
      </p>
    </div>

    <div class="faq-list">
      {
        FAQ.map((f) => (
          <details class="faq-item">
            <summary>
              <span class="ro" lang="ro">{f.q_ro}</span>
              <span class="en" lang="en" data-nosnippet hidden>{f.q_en}</span>
            </summary>
            <div class="faq-answer">
              <span class="ro" lang="ro">{f.a_ro}</span>
              <span class="en" lang="en" data-nosnippet hidden>{f.a_en}</span>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
