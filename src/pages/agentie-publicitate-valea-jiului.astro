---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Overlay from '../components/Overlay.astro';
import Services from '../components/Services.astro';
import Proof from '../components/Proof.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { LOCAL_LANDING } from '../data/site.js';

const path = `/${LOCAL_LANDING.slug}`;
---

<Base
  title={LOCAL_LANDING.title}
  description={LOCAL_LANDING.description}
  keywords={LOCAL_LANDING.keywords}
  path={path}
  service={{
    name: LOCAL_LANDING.schemaName,
    description: LOCAL_LANDING.schemaDescription,
    slug: LOCAL_LANDING.slug,
  }}
>
  <Nav />
  <Overlay />

  <main>
    <nav class="service-back-nav" aria-label="Navigare pagină locală">
      <div class="container">
        <a href="/" class="mono service-back-link">
          <span class="ro" lang="ro">← JEJE.RBG — ACASĂ</span>
          <span class="en" lang="en" data-nosnippet hidden>← JEJE.RBG — HOME</span>
        </a>
      </div>
    </nav>
    <Services />
    <Proof />
    <Faq />
    <Contact />
  </main>

  <MobileMenu />
</Base>

<script>
  import '../scripts/main.js';
</script>

<style>
  .service-back-nav {
    padding: calc(var(--nav-height, 4rem) + 1rem) 0 0;
  }

  .service-back-link {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .service-back-link:hover {
    opacity: 1;
  }
</style>
