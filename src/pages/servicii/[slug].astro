---
import ServicePage from '../../layouts/ServicePage.astro';
import Branding from '../../components/Branding.astro';
import GraphicDesign from '../../components/GraphicDesign.astro';
import VideoSocial from '../../components/VideoSocial.astro';
import WebDev from '../../components/WebDev.astro';
import Services from '../../components/Services.astro';
import Contact from '../../components/Contact.astro';
import { SERVICE_PAGES } from '../../data/site.js';

export function getStaticPaths() {
  return SERVICE_PAGES.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<ServicePage page={page}>
  {page.section === 'branding' && <Branding />}
  {page.section === 'graphic-design' && <GraphicDesign />}
  {page.section === 'video-social' && <VideoSocial />}
  {page.section === 'web-dev' && <WebDev />}
  {page.section === 'servicii' && <Services />}
  <Contact />
</ServicePage>
